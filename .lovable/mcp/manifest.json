{
  "version": 1,
  "sdk_version": "2.1.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://xcdrekokfvzxnfefajlw.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "gs-hub",
      "version": "0.1.0",
      "title": "Gestão Online"
    },
    "tools": [
      {
        "name": "whoami",
        "title": "Quem sou eu",
        "description": "Retorna o perfil do usuário conectado (nome, e-mail, cargo e setores).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_tickets",
        "title": "Listar atendimentos",
        "description": "Lista atendimentos (chamados) com filtros opcionais de status, setor, placa, telefone e período de criação.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "status": {
              "description": "Status do chamado, ex.: aberto, fechado.",
              "type": "string"
            },
            "sector": {
              "description": "Nome do setor (busca parcial).",
              "type": "string"
            },
            "plate": {
              "description": "Placa do veículo (busca parcial).",
              "type": "string"
            },
            "phone": {
              "description": "Telefone do contato (busca parcial).",
              "type": "string"
            },
            "created_from": {
              "description": "Data inicial ISO (ex.: 2026-09-01).",
              "type": "string"
            },
            "created_to": {
              "description": "Data final ISO (ex.: 2026-09-30).",
              "type": "string"
            },
            "limit": {
              "default": 25,
              "description": "Máximo de registros (1-100).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_ticket",
        "title": "Detalhes do atendimento",
        "description": "Retorna os detalhes de um atendimento pelo número de protocolo ou pelo id.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "protocol_number": {
              "description": "Número do protocolo do chamado.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "ticket_id": {
              "description": "Identificador do chamado.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_chats",
        "title": "Listar conversas do WhatsApp",
        "description": "Lista as conversas da Central de Atendimento com filtros de status, setor e telefone.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "status": {
              "description": "Status da conversa, ex.: open, closed, waiting.",
              "type": "string"
            },
            "sector": {
              "description": "Nome do setor (busca parcial).",
              "type": "string"
            },
            "phone": {
              "description": "Telefone do contato (busca parcial).",
              "type": "string"
            },
            "limit": {
              "default": 25,
              "description": "Máximo de registros (1-100).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "financeiro_categorias",
        "title": "Financeiro: categorias e empresas",
        "description": "Lista as categorias ativas do Financeiro (nome, tipo, grupo do DRE) e as empresas do grupo (código, nome, CNPJ). Use antes de registrar documentos.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "financeiro_documentos_registrados",
        "title": "Financeiro: arquivos já registrados",
        "description": "Recebe uma lista de IDs de arquivos do Google Drive e devolve quais já foram registrados no Financeiro, para não lançar de novo.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "drive_file_ids": {
              "minItems": 1,
              "maxItems": 200,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 5,
                "maxLength": 200
              },
              "description": "IDs dos arquivos no Google Drive."
            }
          },
          "required": [
            "drive_file_ids"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "financeiro_registrar_documento",
        "title": "Financeiro: registrar documento do Drive",
        "description": "Cria um lançamento a pagar (status aberto, 'A revisar') a partir de um comprovante/boleto/nota lido do Google Drive. Não duplica: se o drive_file_id já existir, devolve o lançamento existente. Categoria e empresa são pelo nome/código de financeiro_categorias.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": true,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "drive_file_id": {
              "type": "string",
              "minLength": 5,
              "maxLength": 200
            },
            "arquivo_nome": {
              "type": "string",
              "maxLength": 300
            },
            "arquivo_url": {
              "type": "string",
              "maxLength": 1000,
              "format": "uri"
            },
            "empresa": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 20
                },
                {
                  "type": "null"
                }
              ],
              "description": "Código da empresa pagadora (ex.: OR)."
            },
            "tipo_documento": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "boleto",
                    "nota_fiscal",
                    "recibo",
                    "cupom_fiscal",
                    "guia",
                    "fatura",
                    "outro"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "contraparte": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ],
              "description": "Fornecedor/beneficiário."
            },
            "documento_contraparte": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 30
                },
                {
                  "type": "null"
                }
              ],
              "description": "CNPJ/CPF do fornecedor."
            },
            "descricao": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 500
                },
                {
                  "type": "null"
                }
              ]
            },
            "categoria": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Nome exato de uma categoria ativa."
            },
            "valor": {
              "type": "number",
              "minimum": 0,
              "maximum": 100000000
            },
            "data_emissao": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "vencimento": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "competencia": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Qualquer dia do mês de competência."
            },
            "linha_digitavel": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 120
                },
                {
                  "type": "null"
                }
              ]
            },
            "numero_documento": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            },
            "confianca": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "pago": {
              "description": "true para cupom/recibo já pago (usa vencimento como data de pagamento).",
              "type": "boolean"
            },
            "revisado": {
              "description": "true quando o usuário já conferiu os dados na conversa (não vai para a fila A revisar).",
              "type": "boolean"
            },
            "observacao": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 1000
                },
                {
                  "type": "null"
                }
              ],
              "description": "Descrição dada pelo usuário, ex.: 'almoço com cliente X'."
            }
          },
          "required": [
            "drive_file_id",
            "arquivo_nome",
            "valor"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "financeiro_criar_categoria",
        "title": "Financeiro: criar categoria",
        "description": "Cria uma categoria nova no Financeiro (ou reativa uma existente com o mesmo nome). Use SOMENTE depois que o usuário confirmar o nome da categoria nova.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": true,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "nome": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80
            },
            "tipo": {
              "default": "despesa",
              "type": "string",
              "enum": [
                "despesa",
                "receita"
              ]
            },
            "grupo_dre": {
              "default": "Despesas operacionais",
              "description": "Grupo do DRE onde a categoria soma.",
              "type": "string",
              "enum": [
                "Receita bruta",
                "Outras receitas",
                "Custo dos serviços",
                "Impostos",
                "Pessoal",
                "Despesas comerciais",
                "Despesas administrativas",
                "Despesas operacionais",
                "Despesas financeiras",
                "Outras despesas"
              ]
            }
          },
          "required": [
            "nome"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
